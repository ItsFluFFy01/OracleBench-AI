{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoundResult - PROPOSITION v0, à valider par A, B et C",
  "description": "Schéma du résultat d'un round après détection d'anomalies, réputation et agrégation",
  "type": "object",
  "required": [
    "round_id",
    "final_value",
    "confidence",
    "proof_hash",
    "per_oracle",
    "methods"
  ],
  "properties": {
    "round_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Identifiant séquentiel unique du round"
    },
    "final_value": {
      "type": "number",
      "description": "Valeur finale retenue (ex: méthode IA ou médiane filtrée)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Score de confiance global entre 0.0 et 1.0"
    },
    "proof_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Hash hexadécimal 0x... (32 octets) prouvant l'intégrité du round"
    },
    "per_oracle": {
      "type": "array",
      "description": "Détails par oracle pour le round courant",
      "items": {
        "type": "object",
        "required": ["oracle_id", "value", "anomaly_score", "reputation", "status"],
        "properties": {
          "oracle_id": {
            "type": "string",
            "description": "Identifiant du nœud oracle"
          },
          "value": {
            "type": "number",
            "description": "Valeur fournie par cet oracle"
          },
          "anomaly_score": {
            "type": "number",
            "description": "Score d'anomalie calculé par l'IA (Isolation Forest)"
          },
          "reputation": {
            "type": "number",
            "description": "Score de réputation de l'oracle (0.0 à 1.0)"
          },
          "status": {
            "type": "string",
            "enum": ["NORMAL", "ALERT"],
            "description": "Statut après classification"
          }
        },
        "additionalProperties": false
      }
    },
    "methods": {
      "type": "object",
      "description": "Valeurs agrégées obtenues selon les différentes méthodes de référence et l'IA",
      "required": ["mean", "median", "trimmed", "weighted", "ai"],
      "properties": {
        "mean": {
          "type": "number",
          "description": "Moyenne arithmétique simple"
        },
        "median": {
          "type": "number",
          "description": "Médiane simple"
        },
        "trimmed": {
          "type": "number",
          "description": "Moyenne tronquée (trimmed mean)"
        },
        "weighted": {
          "type": "number",
          "description": "Moyenne pondérée par la réputation"
        },
        "ai": {
          "type": "number",
          "description": "Valeur finale produite par le pipeline IA"
        }
      },
      "additionalProperties": false
    },
    "ground_truth": {
      "type": "number",
      "description": "Vérité terrain réelle (optionnel, présent en mode expérimental)"
    }
  },
  "additionalProperties": false
}
